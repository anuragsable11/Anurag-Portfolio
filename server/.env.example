# ---------------------------------------------------------------------------
# Copy this file to server/.env and fill it in. server/.env is gitignored.
#   cp server/.env.example server/.env
# ---------------------------------------------------------------------------

# Port the Express API listens on
PORT=5000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Set to "production" to also serve client/dist from this server
NODE_ENV=development


# ---------------------------------------------------------------------------
# Contact-form email (Gmail SMTP)
#
# Without these two, the form still works and still saves every message to
# server/data/messages.json — it just will not email you. Check which state
# you are in at http://localhost:5000/api/health
#
# Setup (about two minutes):
#   1. Turn on 2-Step Verification for the Gmail account
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Put the address and the 16-character app password below
#
# Use the app password, NOT the normal Gmail password — Google rejects that
# over SMTP. Spaces inside the app password are fine.
# ---------------------------------------------------------------------------

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional. Where messages land; defaults to GMAIL_USER.
# CONTACT_TO_EMAIL=you@example.com
