# ---------------------------------------------------------------------------
# Copy this file to server/.env and fill it in. server/.env is gitignored.
#   cp server/.env.example server/.env
# ---------------------------------------------------------------------------

# Port the Express API listens on
PORT=5000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Set to "production" to also serve client/dist from this server
NODE_ENV=development


# ---------------------------------------------------------------------------
# Contact-form email
#
# Without these two, the form still works and still saves every message to
# server/data/messages.json — it just will not email you. Check which state
# you are in at http://localhost:5000/api/health
#
# Setup (about two minutes):
#   1. Sign up at https://resend.com with the address you want mail sent to
#   2. Create an API key at https://resend.com/api-keys
#   3. Paste it below and set CONTACT_TO_EMAIL to that same address
#
# On the default sender below, Resend only delivers to the address that owns
# the API key. That is fine for a personal portfolio. To send elsewhere,
# verify a domain in Resend and set CONTACT_FROM_EMAIL to an address on it.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional. Leave unset to use Resend's shared test sender.
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
